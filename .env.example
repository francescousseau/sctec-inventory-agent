# LLM: Gemini Developer API (Google AI Studio) — crie a chave em https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=30

# API de estoque executada no computador host
ESTOQUE_API_URL=http://host.docker.internal:8000
ESTOQUE_TIMEOUT_S=5
ESTOQUE_RETRIES=1
ESTOQUE_RETRY_BACKOFF_S=0.2
MENSAGEM_MAX_CHARS=500
